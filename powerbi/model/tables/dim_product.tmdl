table dim_product

	column product_key
		dataType: string
		summarizeBy: none
		sourceColumn: product_key
		isKey

	column product_name
		dataType: string
		summarizeBy: none
		sourceColumn: product_name

	column family_code
		dataType: string
		summarizeBy: none
		sourceColumn: family_code

	column family
		dataType: string
		summarizeBy: none
		sourceColumn: family

	partition dim_product = m
		mode: import
		source =
				let
				    Source = Parquet.Document ( File.Contents ( ExportFolder & "dim_product.parquet" ) )
				in
				    Source
