table dim_country

	column country_key
		dataType: int64
		summarizeBy: none
		sourceColumn: country_key
		isKey

	column country_name
		dataType: string
		summarizeBy: none
		sourceColumn: country_name

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column market
		dataType: string
		summarizeBy: none
		sourceColumn: market

	partition dim_country = m
		mode: import
		source =
				let
				    Source = Parquet.Document ( File.Contents ( ExportFolder & "dim_country.parquet" ) )
				in
				    Source
