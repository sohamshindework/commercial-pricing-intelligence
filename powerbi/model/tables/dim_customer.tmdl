table dim_customer

	column customer_key
		dataType: int64
		summarizeBy: none
		sourceColumn: customer_key
		isKey

	column primary_country
		dataType: string
		summarizeBy: none
		sourceColumn: primary_country

	column cohort_month
		dataType: dateTime
		formatString: yyyy-mm
		summarizeBy: none
		sourceColumn: cohort_month

	column is_unknown
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_unknown

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Parquet.Document ( File.Contents ( ExportFolder & "dim_customer.parquet" ) )
				in
				    Source
